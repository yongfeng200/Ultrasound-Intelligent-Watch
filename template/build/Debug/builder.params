{
    "name": "template",
    "target": "Debug",
    "toolchain": "ANY_GCC",
    "toolchainLocation": "c:\\Users\\vkaok\\Desktop\\ls1d100_vscode\\la32-tool",
    "toolchainCfgFile": "c:\\Users\\vkaok\\.vscode\\extensions\\cl.eide-3.20.0\\res\\data\\models\\win32/any.gcc.model.json",
    "buildMode": "fast|multhread",
    "showRepathOnLog": true,
    "threadNum": 12,
    "rootDir": "d:\\windows\\template",
    "dumpPath": "build\\Debug",
    "outDir": "build\\Debug",
    "incDirs": [],
    "libDirs": [],
    "defines": [],
